--- !u!1001 &2202704081686349002
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 3659519136349208760}
    m_Modifications:
    - target: {fileID: 3195491896257348555, guid: 10583537de6e8904799c47cca9c3fd6f, type: 3}
      propertyPath: m_Text
      value: "Looper is inspired by OMNI by Femur (see GitHub for more) and a fascination
        of scales.\r\n\r\n\u201CScale\u201D comes from a Latin word which means ladder.
        A scale is the tonal basis of music. It is a set of tones from which you
        can build melodies and harmonies. The tones of a scale are ordered according
        to their pitch. Since scales create various distinctive moods, atmospheres
        and tonal flavours, there are as many scales as there are cultures around
        the world.\r\n\r\nRecord simple loops and have fun exploring the unique sounds
        of different cultures patterns!\n\n\rSynthesiser and plugin is accredited
        to Matt Tytel."
      objectReference: {fileID: 0}
    - target: {fileID: 3195491896257348555, guid: 10583537de6e8904799c47cca9c3fd6f, type: 3}
